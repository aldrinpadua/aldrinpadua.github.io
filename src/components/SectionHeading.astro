---
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon: 'about' | 'education' | 'experience' | 'publication' | 'project' | 'insight' | 'skills' | 'contact';
  intro?: string;
}

const { title, icon, intro } = Astro.props;
---

<div class="section-heading reveal">
  <span class="icon-badge" aria-hidden="true">
    <Icon name={icon} class={`icon section-icon icon-${icon}`} />
  </span>
  <div>
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </div>
</div>
