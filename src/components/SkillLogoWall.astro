  { label: 'Java', logo: 'https://cdn.simpleicons.org/openjdk/FFFFFF' },
  { label: 'ROS2', logo: 'https://cdn.simpleicons.org/ros/22314E' },
  { label: 'Gazebo', logo: '/assets/skills/gazebo-concept.svg' },
  { label: 'Gazebo Classic', logo: '/assets/skills/gazebo-classic-concept.svg' },
  { label: 'Gazebo Sim', logo: '/assets/skills/gazebo-sim-concept.svg' },
  { label: 'Gazebo Physics', logo: '/assets/skills/gazebo-physics-concept.svg' },
  { label: 'Git', logo: 'https://cdn.simpleicons.org/git/F05032' },
  { label: 'GitHub', logo: 'https://cdn.simpleicons.org/github/181717' },
  { label: 'macOS', logo: 'https://cdn.simpleicons.org/apple/111111' },
