  { label: 'SolidWorks', logo: 'https://cdn.simpleicons.org/dassaultsystemes/005386' },
  { label: 'ROS2', logo: 'https://cdn.simpleicons.org/ros/22314E' },
  { label: 'Gazebo', logo: '/assets/skills/gazebo-concept.svg' },
  { label: 'Path Planning (Concept)', logo: '/assets/skills/path-planning-concept.svg' }
];
---

<section class="skill-arena-section reveal" aria-label="Core skill logos">
  <div class="skill-arena" data-skill-arena>
    <div class="skill-bg-pan" aria-hidden="true"></div>

    <a class="skill-core" href="/skills" aria-label="Open skills page">
      <span>SKILLS</span>
    </a>

    <div class="skill-orbit" aria-hidden="true">
      {
        skillLogos.map((item) => (
          <div class="skill-node" data-skill-node>
            <img src={item.logo} alt="" loading="lazy" decoding="async" />
            <span>{item.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const arena = document.querySelector('[data-skill-arena]');

  if (arena) {
    const nodes = Array.from(arena.querySelectorAll('[data-skill-node]'));
    const core = arena.querySelector('.skill-core');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let particles = [];
    let rafId = 0;

    const randomSpeed = () => (0.65 + Math.random() * 0.65) * 0.25;

    const measure = () => {
      const bounds = arena.getBoundingClientRect();
      const cx = bounds.width / 2;
      const cy = bounds.height / 2;
      const coreSize = core ? core.getBoundingClientRect().width : 180;
      const coreRadius = coreSize / 2 + 10;
      const orbitRadius = Math.min(bounds.width, bounds.height) * 0.33;

      particles = nodes.map((node, index) => {
        const nodeBounds = node.getBoundingClientRect();
        const width = nodeBounds.width || 84;
        const height = nodeBounds.height || 84;
        const angle = (index / nodes.length) * Math.PI * 2;
        const tangent = angle + Math.PI / 2;
        const speed = randomSpeed();

        const x = cx + Math.cos(angle) * orbitRadius - width / 2;
        const y = cy + Math.sin(angle) * orbitRadius - height / 2;

        return {
          node,
          x: Math.min(Math.max(0, x), bounds.width - width),
          y: Math.min(Math.max(0, y), bounds.height - height),
          vx: Math.cos(tangent) * speed * (Math.random() > 0.5 ? 1 : -1),
          vy: Math.sin(tangent) * speed * (Math.random() > 0.5 ? 1 : -1),
          width,
          height
        };
      });

      return { width: bounds.width, height: bounds.height, cx, cy, coreRadius };
    };

    const setPosition = (particle) => {
      particle.node.style.transform = `translate3d(${particle.x}px, ${particle.y}px, 0)`;
    };

    let metrics = measure();
    particles.forEach(setPosition);

    const tick = () => {
      if (prefersReducedMotion) {
        return;
      }

      for (const particle of particles) {
        particle.x += particle.vx;
        particle.y += particle.vy;

        if (particle.x <= 0 || particle.x + particle.width >= metrics.width) {
          particle.vx *= -1;
          particle.x = Math.min(Math.max(0, particle.x), metrics.width - particle.width);
        }

        if (particle.y <= 0 || particle.y + particle.height >= metrics.height) {
          particle.vy *= -1;
          particle.y = Math.min(Math.max(0, particle.y), metrics.height - particle.height);
        }

        const nx = particle.x + particle.width / 2 - metrics.cx;
        const ny = particle.y + particle.height / 2 - metrics.cy;
        const distance = Math.hypot(nx, ny);
        const minimum = metrics.coreRadius + Math.max(particle.width, particle.height) * 0.45;

        if (distance < minimum) {
          const invDistance = distance === 0 ? 1 : 1 / distance;
          const ux = nx * invDistance;
          const uy = ny * invDistance;
          const velocityDot = particle.vx * ux + particle.vy * uy;

          particle.x = metrics.cx + ux * minimum - particle.width / 2;
          particle.y = metrics.cy + uy * minimum - particle.height / 2;

          if (velocityDot < 0) {
            particle.vx -= 2 * velocityDot * ux;
            particle.vy -= 2 * velocityDot * uy;
          }
        }

        setPosition(particle);
      }

      rafId = requestAnimationFrame(tick);
    };

    if (!prefersReducedMotion) {
      rafId = requestAnimationFrame(tick);
    }

    let resizeTimeout;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        metrics = measure();
        particles.forEach(setPosition);
      }, 120);
    });

    window.addEventListener('beforeunload', () => {
      if (rafId) {
        cancelAnimationFrame(rafId);
      }
    });
  }
</script>
