  { label: 'Bambu Lab', logo: 'https://cdn.simpleicons.org/bambulab/00A3E0' },
  { label: 'Formlabs', logo: '/assets/skills/formlabs-concept.svg' },
  { label: 'OpenCV', logo: 'https://cdn.simpleicons.org/opencv/5C3EE8' },
  { label: 'TensorFlow', logo: 'https://cdn.simpleicons.org/tensorflow/FF6F00' },
  { label: 'Keras', logo: 'https://cdn.simpleicons.org/keras/D00000' },
  { label: 'MATLAB (Concept)', logo: '/assets/skills/matlab-concept.svg' },
  { label: 'Path Planning (Concept)', logo: '/assets/skills/path-planning-concept.svg' },
  { label: 'Motion Planning (Concept)', logo: '/assets/skills/motion-planning-concept.svg' },
  { label: 'Eng Math (Concept)', logo: '/assets/skills/engineering-math-concept.svg' },
  { label: 'Scikit-learn', logo: 'https://cdn.simpleicons.org/scikitlearn/F7931E' },
  { label: 'Arduino', logo: 'https://cdn.simpleicons.org/arduino/00878F' },
