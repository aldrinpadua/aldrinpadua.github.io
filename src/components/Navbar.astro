---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/education', label: 'Education' },
  { href: '/experience', label: 'Experience' },
  { href: '/publications', label: 'Publications' },
  { href: '/projects', label: 'Projects' },
  { href: '/insights', label: 'Insights' },
  { href: '/skills', label: 'Skills' },
  { href: '/contact', label: 'Contact' }
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <nav class="container nav" aria-label="Primary navigation">
    <a class="brand" href="/">Aldrin Padua</a>
    <ul>
      {
        navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = pathname === itemPath || (itemPath !== '/' && pathname.startsWith(`${itemPath}/`));
          return (
            <li>
              <a href={item.href} class={isActive ? 'active' : undefined} aria-current={isActive ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
