---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { education } from '../data/education';

const educationIconMeta = (degree: string) => {
  const lower = degree.toLowerCase();

  if (lower.includes('mechanical')) {
    return { icon: 'edu-phd-me', colorClass: 'edu-icon-phd-me' };
  }
  if (lower.includes('robotics')) {
    return { icon: 'edu-ms-robotics', colorClass: 'edu-icon-ms-robotics' };
  }
  if (lower.includes('electrical')) {
    return { icon: 'edu-diploma-ee', colorClass: 'edu-icon-diploma-ee' };
  }

  return { icon: 'edu-bs-ece', colorClass: 'edu-icon-bs-ece' };
};

const educationLogoMap: Record<string, string> = {
  'Stevens Institute of Technology': 'https://logo.clearbit.com/stevens.edu',
  'International College of Auckland': 'https://logo.clearbit.com/ica.ac.nz',
  'Mapua Institute of Technology': 'https://logo.clearbit.com/mapua.edu.ph'
};
---

<MainLayout title="Education" description="Academic progression and training in robotics and engineering.">
  <SectionHeading
    title="Education"
    icon="education"
    intro="Academic progression from electronics engineering to robotics graduate training and current doctoral research."
  />

  <section class="timeline" aria-label="Education timeline">
    {
      education.map((item, index) => {
        const eduIcon = educationIconMeta(item.degree);

        return (
        <article class="timeline-card education-entry reveal">
          <div class="timeline-date">{item.completed}</div>
          <div>
            {index < 2 && <p class="role-badge role-badge-research">priority degree</p>}
            <div class="section-card-head">
              <span class="section-card-icon">
                <Icon name={eduIcon.icon} class={`icon section-icon ${eduIcon.colorClass}`} />
              </span>
              <h2>{item.degree}</h2>
            </div>
            <div class="education-institution-row">
              {educationLogoMap[item.institution] && (
                <img
                  class="education-school-logo"
                  src={educationLogoMap[item.institution]}
                  alt={`${item.institution} logo`}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <p class="timeline-meta">{item.institution} • {item.location}</p>
            </div>
            <ul class="bullet-list compact">
              {item.focus && <li><strong>Research Focus:</strong> {item.focus}</li>}
              {item.gpa && <li><strong>GPA:</strong> {item.gpa}</li>}
              {item.award && <li><strong>Award:</strong> {item.award}</li>}
              {item.highlight && <li>{item.highlight}</li>}
            </ul>
          </div>
        </article>
      );
      })
    }
  </section>
</MainLayout>
