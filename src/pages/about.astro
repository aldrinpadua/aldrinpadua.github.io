---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { socials } from '../data/socials';

const aboutHighlights = [
  'Digital Human Modeling',
  'Biomechanics-Aware Analysis',
  'Robotic End-Effector Prototyping',
  'Controls + System Integration',
  'DoD SBIR Research'
];

const journeySteps = [
  'Electronics Engineering',
  'MS Robotics',
  'PhD Research',
  'Safety-Critical Robotics'
];
---

<MainLayout
  title="About"
  description="About Aldrin Padua: robotics researcher and engineer working across simulation, control, and mechatronic prototyping."
>
  <SectionHeading
    title="About"
    icon="about"
    intro="Robotics researcher and engineer focused on safe physical interaction, simulation-informed design, and practical robotic implementation."
  />

  <section class="content-card about-story-strip reveal" aria-label="Career and research snapshot">
    <div class="about-journey" aria-label="Professional journey">
      {
        journeySteps.map((step) => (
          <span class="about-journey-step">{step}</span>
        ))
      }
    </div>
    <ul class="about-highlight-grid" aria-label="Profile highlights">
      {
        aboutHighlights.map((highlight) => (
          <li class="about-highlight-chip">{highlight}</li>
        ))
      }
    </ul>
  </section>

  <section class="about-grid" aria-label="About overview">
    <article class="content-card about-card about-card-summary reveal" aria-labelledby="bio-title">
      <div class="about-card-head">
        <span class="about-card-icon">
          <Icon name="about-profile" class="icon section-icon icon-about-summary" />
        </span>
        <h2 id="bio-title">Professional Summary</h2>
      </div>
      <p><strong>Research identity:</strong> {profile.aboutSummary}</p>
      <p class="body-spacer"><strong>Technical profile:</strong> {profile.technicalIdentity}</p>
      <p class="body-spacer"><strong>Implementation stance:</strong> {profile.professionalPositioning}</p>
    </article>

    <article class="content-card about-card about-card-focus reveal" aria-labelledby="focus-title">
      <div class="about-card-head">
        <span class="about-card-icon">
          <Icon name="about-focus" class="icon section-icon icon-about-focus" />
        </span>
        <h2 id="focus-title">Current Focus</h2>
      </div>
      <ul class="bullet-list compact">
        {
          profile.currentFocus.map((focusItem) => (
            <li>{focusItem}</li>
          ))
        }
      </ul>
    </article>

    <article class="content-card about-card about-card-research reveal" aria-labelledby="research-title">
      <div class="about-card-head">
        <span class="about-card-icon">
          <Icon name="about-research" class="icon section-icon icon-about-research" />
        </span>
        <h2 id="research-title">Research Interests</h2>
      </div>
      <ul class="bullet-list compact">
        {
          profile.researchInterests.map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
    </article>

    <article class="content-card about-card about-card-approach reveal" aria-labelledby="approach-title">
      <div class="about-card-head">
        <span class="about-card-icon">
          <Icon name="about-approach" class="icon section-icon icon-about-approach" />
        </span>
        <h2 id="approach-title">Engineering Approach</h2>
      </div>
      <ul class="bullet-list compact">
        {
          profile.engineeringApproach.map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
    </article>
  </section>

  <section class="content-card about-now-next reveal" aria-labelledby="now-next-title">
    <h2 id="now-next-title">Now and Next</h2>
    <div class="about-now-next-grid">
      <article class="about-now-next-block">
        <h3>Now</h3>
        <ul class="bullet-list compact">
          {
            profile.currentFocus.slice(0, 3).map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </article>
      <article class="about-now-next-block">
        <h3>Next</h3>
        <ul class="bullet-list compact">
          {
            profile.engineeringApproach.slice(0, 3).map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="content-card about-contact-card reveal" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact and Socials</h2>
    <p>
      <strong>Email:</strong>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <p class="body-spacer"><strong>Location:</strong> {profile.location}</p>

    <div class="social-row" aria-label="Social profiles">
      {
        socials.map((social) => {
          const isExternal = social.url.startsWith('http');
          const isMail = social.url.startsWith('mailto:');
          const isPlaceholder = social.url === '#';
          if (isPlaceholder) {
            return (
              <span class="social-pill is-disabled" aria-disabled="true">
                <Icon name={social.icon} class="icon" />
                <span>{social.label}</span>
              </span>
            );
          }
          return (
            <a class="social-pill" href={social.url} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noreferrer' : undefined}>
              <Icon name={social.icon} class="icon" />
              <span>{social.label}</span>
              {isMail && <span class="sr-only"> (email link)</span>}
            </a>
          );
        })
      }
      <a class="social-pill" href="https://scholar.google.com/citations?user=uYye3P4AAAAJ&hl=en" target="_blank" rel="noreferrer">
        <Icon name="scholar" class="icon" />
        <span>Google Scholar</span>
      </a>
    </div>

    {
      socials
        .filter((social) => social.note)
        .map((social) => (
          <p class="muted-note"><strong>{social.label}:</strong> {social.note}</p>
        ))
    }
  </section>
</MainLayout>
