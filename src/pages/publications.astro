---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { publications } from '../data/publications';
---

<MainLayout
  title="Publications"
  description="Research publications in casualty manipulation, digital human modeling, and tactile human-robot interaction simulation."
>
  <SectionHeading
    title="Publications"
    icon="publication"
    intro="Peer-reviewed work at the intersection of safety, biomechanics, and physically interactive robotics."
  />

  <section class="publication-list" aria-label="Publication entries">
    {
      publications.map((publication, index) => {
        const publicationIcon = index % 2 === 0 ? 'pub-casualty' : 'pub-multifidelity';

        return (
          <article class="publication-card reveal">
            <div class="publication-header">
              <p class="eyebrow-text">{publication.authorshipRole}</p>
              <p class="year-pill">{publication.year}</p>
            </div>

            <div class="section-card-head">
              <span class="section-card-icon">
                <Icon name={publicationIcon} class="icon section-icon icon-publication" />
              </span>
              <h2>{publication.title}</h2>
            </div>
            <p class="timeline-meta">{publication.venue}</p>
            <p>{publication.summary}</p>

            <p class="doi-line">
              <strong>DOI</strong>
              <a class="doi-link" href={`https://doi.org/${publication.doi}`} target="_blank" rel="noreferrer">
                {publication.doi}
              </a>
            </p>
          </article>
        );
      })
    }
  </section>

  <section class="publication-footer reveal" aria-label="Scholar profile link">
    <a class="btn btn-primary" href="https://scholar.google.com/citations?user=uYye3P4AAAAJ&hl=en" target="_blank" rel="noreferrer">
      <Icon name="pub-scholar" class="icon" />
      <span>View Google Scholar</span>
    </a>
  </section>
</MainLayout>
