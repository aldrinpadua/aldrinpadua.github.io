---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import SkillLogoWall from '../components/SkillLogoWall.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { publications } from '../data/publications';
import { skillGroups } from '../data/skills';
---

<MainLayout title="Home" description={profile.seoDescription}>
  <Hero />

  <section class="overview-grid" aria-label="Portfolio highlights">
    <article class="card reveal">
      <p class="card-kicker">Positioning</p>
      <h2>Research-to-Implementation Engineering</h2>
      <p>{profile.professionalPositioning}</p>
      <a class="inline-link" href="/about">Read profile</a>
    </article>

    <article class="card reveal">
      <p class="card-kicker">Current Work</p>
      <h2>Human-Safe Manipulation Research</h2>
      <p>{experience[0].bullets[1]}</p>
      <a class="inline-link" href="/experience">View experience</a>
    </article>

    <article class="card reveal">
      <p class="card-kicker">Publication</p>
      <h2>Latest First-Author Paper</h2>
      <p>{publications[0].title}</p>
      <a class="inline-link" href="/publications">View publications</a>
    </article>

    <article class="card reveal">
      <p class="card-kicker">Technical Breadth</p>
      <h2>Core Capabilities</h2>
      <p>{skillGroups.slice(0, 4).map((group) => group.category).join(' • ')}</p>
      <a class="inline-link" href="/skills">View skill groups</a>
    </article>
  </section>

  <SkillLogoWall />
</MainLayout>
