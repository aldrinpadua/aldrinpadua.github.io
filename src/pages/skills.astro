---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { skillGroups } from '../data/skills';

const skillThemes = ['skill-theme-a', 'skill-theme-b', 'skill-theme-c', 'skill-theme-d'];

const iconForCategory = (category: string) => {
  if (category.includes('Robotics') || category.includes('Controls')) return { icon: 'experience', colorClass: 'skill-icon-robotics' };
  if (category.includes('Simulation') || category.includes('AI')) return { icon: 'insight', colorClass: 'skill-icon-simulation' };
  if (category.includes('Programming')) return { icon: 'project', colorClass: 'skill-icon-programming' };
  if (category.includes('CAD') || category.includes('Engineering Tools')) return { icon: 'education', colorClass: 'skill-icon-cad' };
  if (category.includes('Hardware') || category.includes('Prototyping')) return { icon: 'skills', colorClass: 'skill-icon-hardware' };
  if (category.includes('Platforms') || category.includes('Software')) return { icon: 'contact', colorClass: 'skill-icon-platforms' };
  if (category.includes('Languages')) return { icon: 'about', colorClass: 'skill-icon-languages' };
  return { icon: 'skills', colorClass: 'skill-icon-default' };
};
---

<MainLayout title="Skills" description="Technical skills across robotics, simulation, programming, and hardware systems.">
  <SectionHeading
    title="Skills"
    icon="skills"
    intro="Grouped technical competencies across robotics research, simulation workflows, software development, and hardware prototyping."
  />

  <section class="lead-panel reveal skills-intro-panel" aria-label="Skills overview">
    <p>
      A broad engineering stack spanning robot reasoning, physically interactive simulation, rapid prototyping, and full software-to-hardware delivery workflows.
    </p>
  </section>

  <section class="skills-grid" aria-label="Skill groups">
    {
      skillGroups.map((group, index) => {
        const iconMeta = iconForCategory(group.category);

        return (
          <article class={`card reveal skill-card skill-card-rich ${skillThemes[index % skillThemes.length]}`}>
            <div class="skill-card-head">
              <span class="section-card-icon">
                <Icon
                  name={iconMeta.icon}
                  class={`icon section-icon ${iconMeta.colorClass}`}
                />
              </span>
              <h2>{group.category}</h2>
            </div>
            <ul class="chip-list">
              {
                group.items.map((skill) => (
                  <li>{skill}</li>
                ))
              }
            </ul>
          </article>
        );
      })
    }
  </section>
</MainLayout>
